# SQLite file (relative to prisma/). For Postgres: postgresql://user:pass@host:5432/truthlens
DATABASE_URL="file:./truthlens.db"

# Optional. When set, the multi-agent pipeline runs on Claude; otherwise the offline heuristic engine is used.
ANTHROPIC_API_KEY=""
# Optional overrides
TRUTHLENS_MODEL="claude-opus-5-5"
TRUTHLENS_ENGINE="auto"   # auto | claude | heuristic
